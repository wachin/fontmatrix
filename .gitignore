# Fontmatrix
# Generated build files and local development artifacts.
# Keep source files in Git; keep out-of-source build trees out of Git.

# CMake out-of-source builds
/build/
/build-*/
/cmake-build-*/

# CMake generated files (in case CMake is run in the source tree)
CMakeCache.txt
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Makefile
CMakeFiles/
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Testing/

# Qt generated files
moc_*.cpp
moc_*.cpp_parameters
qrc_*.cpp
ui_*.h
qmake_image_collection.cpp
*.qm

# qmake generated files
Makefile.Release
Makefile.Debug
.qmake.stash
qmake.stash

# Compiled objects, libraries and executables
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe

# IDE / editor local files
*.kdevelop.pcs
*.kdevses
.vscode/
.idea/
*.user
*.user.*
*~

# Temporary / backup files
*.bak
*.tmp
*.swp
*.swo

# Legacy/generated Fontmatrix files
/src/mainview.ui_BAK
/src/fontmatrix_splashscreen.png

# Nested HarfBuzz checkout/build artifacts used by the legacy tree
/harfbuzz/.git
/harfbuzz/tests
/harfbuzz/.gitignore

# Doxygen/generated documentation
/Doxyfile
/templates
